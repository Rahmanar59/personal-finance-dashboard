# PostgreSQL connection string used by Next.js and Drizzle
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Use a unique random value with at least 32 characters (for example: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Optional; Next.js defaults to 3000
PORT=3000
